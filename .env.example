# Copia questo file in .env e adatta i valori. Il file .env non va versionato.
# Indirizzo di LM Studio. In Docker usare: http://host.docker.internal:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo del modello, come restituito da GET /v1/models
LMSTUDIO_MODEL=google/gemma-4-e2b
# Timeout in secondi
LMSTUDIO_TIMEOUT=120
LMSTUDIO_TEMPERATURE=0.2
# Numero massimo di passaggi del grafo per domanda (intero >= 1)
MAX_STEPS=5
# Numero massimo di revisioni della risposta (intero >= 0)
MAX_REVIEWS=3
# Token stimati oltre i quali la cronologia viene riassunta (intero >= 1)
SUMMARY_THRESHOLD=4000
# Turni recenti tenuti interi nel riassunto (intero >= 1)
SUMMARY_KEEP_TURNS=2
DEFAULT_TIMEZONE=Europe/Rome
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Mostra il ragionamento del modello mentre risponde (true o false)
SHOW_REASONING=true
# Indirizzo del servizio delle note. Vuoto (anche con Docker Compose): l'agente avvia il servizio da solo.
# NOTES_SERVICE_URL=
# Indirizzo dell'agente. Vuoto in locale: l'assistente avvia l'agente da solo.
# Docker Compose la imposta da solo (http://agent:8001).
# AGENT_SERVICE_URL=
# File con la descrizione dell'ambito dell'assistente (percorso relativo alla radice del progetto)
# SCOPE_FILE=config/ambito.txt
# File delle preferenze dell'utente (lingua, fuso orario, stile), relativo alla radice del progetto
PREFERENCES_FILE=config/preferenze.json
# Database PostgreSQL del back-end (servizio db di Compose)
POSTGRES_USER=lab
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=lab
# Indirizzo del database per il back-end in locale
DATABASE_URL=postgresql://lab:cambiami@127.0.0.1:5433/lab
# Indirizzo dell'agente per il back-end (vuoto: valore predefinito)
# BACKEND_AGENT_URL=http://127.0.0.1:8001
# Indirizzo del back-end per il front-end (vuoto: valore predefinito)
# FRONTEND_BACKEND_URL=http://127.0.0.1:8002
# Origini del front-end ammesse dal back-end (CORS), separate da virgole
# BACKEND_CORS_ORIGINS=http://127.0.0.1:8003,http://localhost:8003
# Se impostata, attiva i test sul PostgreSQL vero (usano uno schema temporaneo)
# TEST_DATABASE_URL=
