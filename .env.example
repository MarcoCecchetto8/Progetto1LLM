# Copia questo file in .env e adatta i valori. Il file .env non va versionato.
# Indirizzo di LM Studio. In Docker usare: http://host.docker.internal:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo del modello, come restituito da GET /v1/models
LMSTUDIO_MODEL=google/gemma-4-e2b
# Timeout in secondi
LMSTUDIO_TIMEOUT=120
LMSTUDIO_TEMPERATURE=0.2
# Numero massimo di passaggi del grafo per domanda (intero >= 1)
MAX_STEPS=5
DEFAULT_TIMEZONE=Europe/Rome
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
